# Use a fresh development database. Transactions require a replica set or Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/ledger_demo?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development
EMAIL_ENABLED=false
# Optional Gmail OAuth configuration; never commit real values.
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
